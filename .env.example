# VoceChat bot API keys (get these from VoceChat Settings > Bot&Webhook)
GENERAL_BOT_API_KEY=your-general-bot-api-key
JELLYFIN_BOT_API_KEY=your-jellyfin-bot-api-key
JELLYSEERR_BOT_API_KEY=your-jellyseerr-bot-api-key

# Jellyseerr API key (Settings > General > API Key)
JELLYSEERR_API_KEY=your-jellyseerr-api-key

# Jellyfin API key (Dashboard > API Keys)
JELLYFIN_API_KEY=your-jellyfin-api-key

# Optional: override config file path
# CONFIG_PATH=/app/config.yaml
